HOST=127.0.0.1
PORT=4300
PLATFORM_DATABASE_URL=postgresql://asistencia_platform:CAMBIAR_PASSWORD_DB@127.0.0.1:5432/asistencia_platform
PLATFORM_ADMIN_NAME=Operador
PLATFORM_ADMIN_EMAIL=operador@example.com
PLATFORM_ADMIN_PASSWORD=

# URL pública de asistencia. Separa varias instalaciones con comas.
PLATFORM_TENANT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En desarrollo, permite copiar el enlace de invitación desde el panel.
PLATFORM_MAIL_TRANSPORT=preview

# Para correo real, configura el remitente y el servicio SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURE=false

# En producción, usar HTTPS en el proxy y en las instalaciones vinculadas.
# NODE_ENV=production
