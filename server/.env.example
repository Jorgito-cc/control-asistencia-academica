PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456789
DB_NAME=modulo2

JWT_SECRET=pon-un-secreto-largo
JWT_EXPIRES_IN=8h

APP_TZ=America/La_Paz

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456789
ADMIN_NAME=Administrador

# Activa estas dos variables juntas en una instalación nueva que use invitación.
# Elige un secreto aleatorio de al menos 32 caracteres para esta institución.
# PLATFORM_TENANT_SLUG=mi-institucion
# PLATFORM_BOOTSTRAP_KEY=

# tenant solo sirve asistencia, platform solo sirve la landing y el panel,
# combined sirve ambos para desarrollo local. Sin APP_MODE se usa tenant,
# o combined si se configura PLATFORM_DATABASE_URL.
# APP_MODE=combined
# HOST=localhost
# PLATFORM_DATABASE_URL=postgresql://asistencia_platform:CAMBIAR_PASSWORD@127.0.0.1:5432/asistencia_platform
# PLATFORM_ADMIN_EMAIL=operador@example.com
# PLATFORM_ADMIN_NAME=Operador
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_TENANT_ORIGINS=http://localhost:5173
# PLATFORM_MAIL_TRANSPORT=preview
